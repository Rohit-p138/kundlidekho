<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Kundli PDF - Birth Chart</title>
  <style>
    @page {
      size: A4;
      margin: 10mm;
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Arial', sans-serif;
      background: white;
      color: #000;
      padding: 0;
      margin: 0;
    }
    
    .page {
      width: 21cm;
      height: 29.7cm;
      background: white;
      padding: 10mm;
      page-break-after: always;
    }
    
    #pdfContent {
      width: 100%;
      height: 100%;
    }
  </style>
</head>
<body>
  <div class="page">
    <div id="pdfContent">
      <%- kundliHtml %>
    </div>
  </div>
</body>
</html>
